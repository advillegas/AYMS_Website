// Firebase Storage rules — Amigas Y Más community.
//
// Upload paths (verified against src/):
//   avatars/{uid}/{file}   — use-avatar-upload.ts        (owner-namespaced)
//   covers/{file}          — cover-photo-uploader.tsx    (not namespaced)
//   gallery/{file}         — photo-gallery.tsx           (not namespaced)
//   posts/{file}           — post-composer.tsx           (not namespaced)
//
// Reads are public (images render across the site, some on signed-out
// pages). Writes require auth, an image content-type, and a size cap.
// Avatars are additionally pinned to the owning uid via the path segment.
//
// Deploy:  firebase deploy --only storage
// or paste into Firebase Console → Storage → Rules.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    function underMb(n) {
      return request.resource.size < n * 1024 * 1024;
    }

    // Avatars: world-readable, written only by the owning user (uid is the
    // path segment), images only, < 5 MB.
    match /avatars/{uid}/{file=**} {
      allow read: if true;
      allow write: if signedIn()
                   && request.auth.uid == uid
                   && isImage()
                   && underMb(5);
    }

    // Cover photos, gallery, and post images are not uid-namespaced in the
    // app, so writes are gated on auth + image type + size rather than
    // ownership. World-readable.
    match /covers/{file=**} {
      allow read: if true;
      allow write: if signedIn() && isImage() && underMb(8);
    }
    match /gallery/{file=**} {
      allow read: if true;
      allow write: if signedIn() && isImage() && underMb(10);
    }
    match /posts/{file=**} {
      allow read: if true;
      allow write: if signedIn() && isImage() && underMb(10);
    }

    // Everything else: denied.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
