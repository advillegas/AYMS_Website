// Firebase Storage rules for the AYMS community.
//
// Switch to TEST MODE in the Firebase console for first-pass usage:
//   1. Firebase Console -> Build -> Storage -> Get Started.
//   2. Pick a region (us-central1 is fine).
//   3. Choose "Start in test mode" (or pick "production mode" and
//      paste the test-mode rules below into the Rules tab).
//   4. Make sure NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET in your
//      environment variables matches the bucket name shown at the top
//      of the Storage page (something like
//      amigas-y-mas-social.firebasestorage.app).
//
// CURRENT: fail closed (deny all). The old test-mode rule relied on an
// expiry date that has now passed; this makes the deny explicit so
// access never hinges on the wall clock. Activate the production block
// below once Firebase Auth is wired (Lane B) and deploy it.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

