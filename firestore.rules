// Firestore Security Rules — Amigas Y Más community.
//
// Model (verified against src/):
//   • Auth: real Firebase Auth (email/password + Google). request.auth.uid
//     is the member's id, and their profile lives at users/{uid} with a
//     `role` field of 'amiga' | 'leader' | 'admin'.
//   • There is NO Admin SDK in the app — every write (including admin
//     panels: channels, roles, events) runs client-side as the signed-in
//     Firebase user. So "admin" in these rules == a signed-in user whose
//     users/{uid}.role == 'admin'. Bootstrap the first admin by setting
//     that field once in the Firebase Console.
//   • Public marketing surfaces (landing + /events) read `users`,
//     `events` and `testimonials` while signed OUT, so those three are
//     world-readable by design. Everything else requires auth, and writes
//     are constrained to the owner (or admin).
//
// Deploy:  firebase deploy --only firestore:rules
// or paste into Firebase Console → Firestore Database → Rules.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ----------------------------- helpers ----------------------------- */

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // The canonical admin signs into Firebase Auth under this email. The
    // app's server-side admin login (ADMIN_PASSWORD) only authenticates
    // the UI — the client bridges it into a real Firebase session under
    // this account (see ensureFirebaseAdminSession in firebase-auth.ts) so
    // request.auth exists for admin writes. Recognising the email directly
    // lets the very first admin write succeed before the users/{uid}
    // profile doc is seeded, and keeps admin working even if that seed
    // write is ever lost. MUST match ADMIN_EMAIL in firebase-auth.ts.
    function isAdminEmail() {
      return signedIn() && request.auth.token.email == 'admin@ayms.com';
    }

    // True for the canonical admin email, OR any signed-in user whose
    // profile doc carries role == 'admin'. exists() guards the brief
    // window before a new user's profile is written (get() on a missing
    // doc would otherwise error → deny).
    function isAdmin() {
      return signedIn() && (
        isAdminEmail()
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    /* ------------------------------ users ------------------------------ */
    // Public member directory (read while signed out for the landing
    // preview). A member may write their OWN profile but may NOT change
    // their role (no self-escalation); admins may write anyone.
    match /users/{uid} {
      allow read: if true;
      // New members self-create as 'amiga' (no self-escalation). The
      // canonical admin email may seed its OWN doc with role 'admin'
      // (bootstrap) — it can only write its own uid, and the email is
      // gated behind the server ADMIN_PASSWORD at sign-in.
      allow create: if (isOwner(uid) && request.resource.data.role == 'amiga')
                    || (isOwner(uid) && isAdminEmail());
      allow update: if (isOwner(uid)
                        && request.resource.data.role == resource.data.role)
                    || (isOwner(uid) && isAdminEmail())
                    || isAdmin();
      allow delete: if isAdmin();
    }

    /* ------------------- config (channels/roles/etc.) ------------------ */
    // config/channels, config/roles, config/userRoles, config/moderation.
    // Any member may read (the UI needs the channel + role maps); only an
    // admin may write.
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /* -------------------------- channel chat --------------------------- */
    // Top-level `messages` collection (channel feed). Anyone signed in
    // reads; you may only create messages authored as yourself. Updates
    // are allowed for reactions / poll votes / thread counts but may NOT
    // reassign authorship. Delete is author-or-admin (moderation).
    match /messages/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn()
                    && (resource.data.userId == request.auth.uid || isAdmin());
    }

    /* --------------------------- direct messages ----------------------- */
    // conversations/{id} gated on the participantIds array; the messages
    // subcollection inherits access from the parent conversation.
    match /conversations/{conversationId} {
      function convo() {
        return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      }
      allow read, update, delete:
        if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create:
        if signedIn() && request.auth.uid in request.resource.data.participantIds;

      match /messages/{messageId} {
        allow read: if signedIn()
                    && request.auth.uid in convo().participantIds;
        allow create: if signedIn()
                      && request.auth.uid in convo().participantIds
                      && request.resource.data.userId == request.auth.uid;
        allow update: if signedIn()
                      && request.auth.uid in convo().participantIds
                      && request.resource.data.userId == resource.data.userId;
        allow delete: if signedIn()
                      && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    /* ------------------------------ events ----------------------------- */
    // Public read (shown on the marketing site). Admin-managed. Members
    // may comment and RSVP via subcollections.
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
                      && request.resource.data.userId == request.auth.uid;
        allow update: if signedIn()
                      && request.resource.data.userId == resource.data.userId;
        allow delete: if signedIn()
                      && (resource.data.userId == request.auth.uid || isAdmin());
      }

      // One RSVP doc per member; the doc id IS the member uid.
      match /rsvps/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
    }

    /* ------------------------------ trips ------------------------------ */
    // Live, admin-published travel offers (src/lib/use-trips.ts). Public
    // read so the marketing /trips page + homepage spotlight render them
    // while signed out; only an admin creates / edits / publishes / deletes.
    // The `published` flag gates public visibility in the client query, not
    // here — drafts stay readable so the admin CRM can list them, matching
    // how `events` and `cmsPages` expose admin-authored content world-wide.
    match /trips/{tripId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ----------------------------- meetups ----------------------------- */
    // Member-organized meetups. Anyone signed in reads; the host creates
    // and edits their own meetup; admins moderate. Attendance lives in the
    // rsvps subcollection (one doc per member, keyed by uid).
    match /meetups/{meetupId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.hostId == request.auth.uid;
      allow update, delete: if signedIn()
                    && (resource.data.hostId == request.auth.uid || isAdmin());

      match /rsvps/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
    }

    /* ------------------------- trip reservations ----------------------- */
    // tripReservations/{autoId} → { tripId, userId, ... }. Members read
    // (capacity counts) and manage their own reservation; admins moderate.
    match /tripReservations/{reservationId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn()
                    && (resource.data.userId == request.auth.uid || isAdmin());
    }

    /* --------------------------- notifications ------------------------- */
    // notifications/{uid}/items/{id} — the recipient is the {uid} path
    // segment. Only the recipient (or an admin) reads; any signed-in user
    // may create a notification FOR another member (e.g. "said hi"); only
    // the recipient mutates read-state / deletes.
    match /notifications/{uid}/items/{itemId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if signedIn();
      allow update, delete: if isOwner(uid);
    }

    /* ---------------------------- friendships -------------------------- */
    // Doc id `friend_{lowerUid}_{higherUid}`, schema { participantIds[],
    // requesterId, recipientId, status }. Either participant reads/updates/
    // deletes; only the requester may create, and only with themselves in
    // the participant set.
    match /friendships/{friendshipId} {
      allow read, update, delete:
        if signedIn() && request.auth.uid in resource.data.participantIds;
      allow create:
        if signedIn()
        && request.auth.uid == request.resource.data.requesterId
        && request.auth.uid in request.resource.data.participantIds;
    }

    /* ------------------------------ reports ---------------------------- */
    // Member-filed moderation reports. A member may file a report as
    // themselves; only admins read / triage / resolve.
    match /reports/{reportId} {
      allow create: if signedIn()
                    && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    /* --------------------------- mod actions --------------------------- */
    // Immutable audit log of moderation actions. Visible to signed-in
    // members (moderation transparency); written only by admins.
    match /modActions/{actionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /* ----------------------- calendar sync configs --------------------- */
    // Admin-only ICS feed configuration. NOTE: the server cron at
    // /api/calendar/sync reads these via unauthenticated REST and will be
    // denied here — that path needs a service account / Admin SDK to run
    // under locked-down rules (pre-existing gap; it was already blocked by
    // the previous deny-all rules, so this is not a regression).
    match /calendarSyncConfigs/{configId} {
      allow read, write: if isAdmin();
    }

    /* -------------------------- newsletter ----------------------------- */
    // Public subscribe form. Anyone may create a signup (validated); the
    // list itself (emails) is private — admin read/manage only.
    match /newsletterSignups/{signupId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() < 320;
      allow read, update, delete: if isAdmin();
    }

    /* -------------------------- testimonials --------------------------- */
    // Curated marketing testimonials shown on the public landing page.
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ----------------------------- CMS pages --------------------------- */
    // Admin page-builder content (see src/lib/cms-store.ts). One doc per
    // page slug under cmsPages/{slug}. Published pages render on the public
    // marketing site, so reads are world-readable by design; only an admin
    // (signed-in Firebase user with users/{uid}.role == 'admin', or the
    // canonical admin email) may create / edit / delete a page.
    match /cmsPages/{slug} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------------------------- CMS config --------------------------- */
    // Site-chrome config managed by the admin page-builder. Currently holds
    // cmsConfig/nav → { links: NavLink[] }, the ordered navbar links shown
    // to every visitor (so reads are public). Admin-only writes. NOTE: this
    // is a SEPARATE collection from the signed-in-only `config/*` used for
    // channels/roles — kept apart precisely because nav must be public.
    match /cmsConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* -------------------------- CMS templates -------------------------- */
    // Reusable page-builder templates saved by the admin (cmsTemplates/{id}).
    // Built-in `starter-*` templates are generated client-side and never
    // written here. Templates are an admin-authoring surface but harmless to
    // expose, and reads stay public for parity with the rest of the CMS.
    match /cmsTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    /* ---------------------------- catch-all ---------------------------- */
    // Anything not matched above is denied. Specific allows above are NOT
    // overridden by this — it is only a safety net for unmodeled paths.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
