# Allow installs to proceed when transitive peer-dep ranges are stale.
#
# Required because @emoji-mart/react@1.1.1 declares
# peer react ^16.8 || ^17 || ^18 but we run React 19. emoji-mart still
# works on React 19 in practice (we're using the .default export and a
# narrow API surface) - they just haven't shipped a release with the
# updated peer range yet.
#
# Without this Vercel's `npm install` fails with ERESOLVE; locally we
# would have to remember `--legacy-peer-deps` on every install.
legacy-peer-deps=true
