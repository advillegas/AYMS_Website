# ============================================================
# AYMS Website environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit secrets.
# ============================================================

# --- Admin login ----------------------------------------------------
# Password for the built-in /admin account. The username is always
# "admin" (or admin@ayms.com). Change this in production.
ADMIN_PASSWORD=change-me-in-production

# --- AI chatbot (Claude Haiku via Anthropic) ------------------------
# Required for the floating /api/chat assistant. Get a key at
# https://console.anthropic.com -> API Keys. The key is read only on
# the server (Route Handler), never shipped to the browser.
ANTHROPIC_API_KEY=

# --- Firebase (community chat) --------------------------------------
# Required for the realtime Discord-style chat at /community.
# Get these values from https://console.firebase.google.com:
#   1. Create a project (free Spark plan is fine).
#   2. Add a Web app (the </> icon in Project Overview).
#   3. Copy the firebaseConfig object into the values below.
#   4. Enable Firestore Database (start in "test mode" for dev,
#      lock down with the rules in src/lib/firebase.ts before launch).
# All NEXT_PUBLIC_ keys are exposed to the browser by design - this is
# how Firebase client SDKs work; security comes from Firestore Rules,
# not from hiding the API key.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# If any of the above are missing the chat falls back to an in-memory
# store (refresh = empty chat) so local dev still works without keys.

# --- GIPHY (GIF picker in community chat) ---------------------------
# Optional. When unset the GIF button is hidden but emoji + text still
# work. Create a free key at https://developers.giphy.com/dashboard
# (App Type: API).
NEXT_PUBLIC_GIPHY_API_KEY=

# --- Stream Video (voice + video community channels) ----------------
# Required to enable real voice / video rooms in any channel marked
# type=voice or type=video. Without these, the channel renders a
# placeholder explaining that voice/video is disabled.
#   1. Sign up at https://getstream.io/video/ (free tier: 250 MAU,
#      30,000 minutes/month).
#   2. Create an app, then grab the credentials from the dashboard:
#         https://dashboard.getstream.io
#   3. NEXT_PUBLIC_STREAM_API_KEY is safe to expose to the browser
#      (Stream's auth model is JWTs signed by your secret).
#      STREAM_API_SECRET is server-only - it signs the per-user JWT
#      handed to clients via /api/stream/token and MUST stay server
#      side. Never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# --- Supabase (backend; dual-run with Firebase) ---------------------
# Create a project at https://supabase.com, then copy Project URL +
# anon (publishable) key from Settings -> API. Flip
# NEXT_PUBLIC_USE_SUPABASE to "true" to route the entire data + auth +
# storage layer at Supabase instead of Firebase; leave it "false" to
# keep running on Firebase. Instant rollback. See MIGRATION.md for the
# full cutover runbook.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_USE_SUPABASE=false

# SERVER-ONLY. The service-role key bypasses Row Level Security. It is
# read by API routes (admin provisioning in /api/auth/login, calendar
# sync, newsletter subscribe, Stream token identity lookups) and by the
# migration scripts. NEVER prefix it with NEXT_PUBLIC_ and never import
# it from a "use client" module — leaking it grants full database
# access to anyone.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, server-only. Only needed if API-route token verification is
# switched to local JWT checks; the default implementation verifies
# access tokens over the network via auth.getUser() and needs no secret
# here.
# SUPABASE_JWT_SECRET=

# --- Calendar sync cron ----------------------------------------------
# Bearer secret guarding POST /api/calendar/sync. REQUIRED in
# production: when unset the route answers 503 and iCal feeds never
# sync. On Vercel, an env var literally named CRON_SECRET is attached
# automatically as "Authorization: Bearer ..." to cron invocations
# (see vercel.json). Use a long random string.
CRON_SECRET=

# --- Migration scripts (CLI-only; never read by the app) -------------
# Set these in the shell when running the one-off migration tooling.
# See MIGRATION.md for the full cutover runbook.
#   FIREBASE_SA   = path to a Firebase service-account JSON file
#                   (scripts/migrate-firestore-to-supabase.mjs)
#   SUPABASE_REF  = Supabase project ref, e.g. abcdefghijklmnopqrst
#                   (scripts/apply-sql.mjs, migrate-firestore-to-supabase.mjs)
#   SUPABASE_KEY  = service_role key
#                   (scripts/migrate-firestore-to-supabase.mjs)
#   SUPABASE_PAT  = personal access token from
#                   https://supabase.com/dashboard/account/tokens
#                   (scripts/apply-sql.mjs; also SUPABASE_ACCESS_TOKEN
#                   for the MCP server in .mcp.json)
#   SB_URL        = https://<ref>.supabase.co (scripts/migrate-storage.mjs)
#   SB_SERVICE    = service_role key (scripts/migrate-storage.mjs)
# FIREBASE_SA=
# SUPABASE_REF=
# SUPABASE_KEY=
# SUPABASE_PAT=
# SB_URL=
# SB_SERVICE=
